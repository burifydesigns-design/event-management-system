PORT=5000
SUPABASE_URL=https://drksbvhyyblfkrdxmxvm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (Vite dev server) used for CORS
FRONTEND_URL=http://localhost:3000

# SMTP email configuration (Nodemailer). Never commit real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_HOST=${SMTP_HOST}
EMAIL_PORT=${SMTP_PORT}
EMAIL_USER=${SMTP_USER}
EMAIL_PASS=${SMTP_PASS}
EMAIL_FROM=no-reply@example.com

# Support contact displayed on ticket emails
SUPPORT_EMAIL=support@example.com

# Node environment
NODE_ENV=development
