# Local development: copy to backend/.env
# Vercel: add the same names under Project Settings > Environment Variables of the API project.
PORT=5000
SUPABASE_URL=https://drksbvhyyblfkrdxmxvm.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Server-only. Never commit it, never prefix it with VITE_, never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Comma-separated list of allowed browser origins (the deployed frontend, plus localhost for dev).
FRONTEND_URL=http://localhost:5173
PAYMENT_PROVIDER=unconfigured

# Comma-separated exact frontend origins; production must not use a wildcard.
# Distributed rate limiting (Upstash Redis REST). Required in production for auth and checkout.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Safaricom Daraja STK Push. Set only in the backend Vercel project.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain.example/api/payments/mpesa/callback
MPESA_TRANSACTION_DESC=Event ticket
