# Public browser config for Supabase (project "event management").
# Copy this file to frontend/.env, then restart `npm run dev`. Without it, the events page cannot load.
# The publishable key is safe in the browser: row-level security limits what it can read.
# Find both values in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://drksbvhyyblfkrdxmxvm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Address of the deployed Express API, including /api. Required for login, orders, tickets and admin pages.
# Local dev defaults to http://localhost:5000/api, so leave this unset when running the backend locally.
# VITE_API_URL=https://your-api-project.vercel.app/api
